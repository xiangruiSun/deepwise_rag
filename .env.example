# Copy to .env (git-ignored). All variables use the INSPECT_RAG_ prefix.

# development | test | production. In production the dev API key below is ignored.
INSPECT_RAG_ENVIRONMENT=development

# Application config in configs/: synthetic.yaml (fabricated data) or baseline.yaml (authorized INSPECT).
INSPECT_RAG_APP_CONFIG=synthetic.yaml

# Canonical store. Default: SQLite under artifacts/. Docker Compose uses PostgreSQL.
# INSPECT_RAG_DATABASE_URL=postgresql+psycopg://inspect_rag:change-me@localhost:5432/inspect_rag

# Search backend: "local" (in-process BM25 + exact kNN, no infrastructure) or "elasticsearch".
INSPECT_RAG_SEARCH_BACKEND=local
INSPECT_RAG_ELASTICSEARCH_URL=http://localhost:9200
# INSPECT_RAG_ELASTICSEARCH_API_KEY=
# INSPECT_RAG_ELASTICSEARCH_USERNAME=
# INSPECT_RAG_ELASTICSEARCH_PASSWORD=

# Where generated artifacts go (indexes, embedding cache, experiment results, manifests).
# INSPECT_RAG_ARTIFACT_DIR=./artifacts

# API keys: JSON object mapping a key to its user, role (annotator|researcher|admin) and access scopes.
# Generate long random keys; never commit real ones.
# INSPECT_RAG_API_KEYS_JSON={"<random-key>": {"user": "alice", "role": "researcher", "scopes": ["research"]}}

# Convenience key for local development only (role admin, scope "research"). Set empty to disable.
INSPECT_RAG_DEV_API_KEY=dev-research-key

INSPECT_RAG_REQUEST_TIMEOUT_SECONDS=60
INSPECT_RAG_LOG_LEVEL=INFO
INSPECT_RAG_CORS_ORIGINS=http://localhost:5173

# Optional
# Local Ollama server for generation.backend=ollama (Compose sets http://ollama:11434 for the backend).
# INSPECT_RAG_OLLAMA_BASE_URL=http://localhost:11434
# INSPECT_RAG_MLFLOW_TRACKING_URI=http://localhost:5000
# INSPECT_RAG_OTEL_ENABLED=false
# Only read when generation.backend=external AND both confirmation flags are set in the config:
# INSPECT_RAG_EXTERNAL_LLM_API_KEY=

# --- Document-corpus platform (app/corpus, /v1 API) ---
# Corpus config in configs/: corpus.yaml (CPU-only) or corpus_neural.yaml (embedding + reranker models).
# INSPECT_RAG_CORPUS_CONFIG=corpus.yaml
# Tenant of the development API key above. Real keys carry their tenant:
#   {"<random-key>": {"user": "alice", "role": "researcher", "scopes": ["restricted"], "tenant": "tenant-000"}}
# INSPECT_RAG_DEV_TENANT=tenant-000
# Bearer token for generation.backend=openai_compatible (vLLM or another OpenAI-compatible server).
# INSPECT_RAG_LLM_API_KEY=

# Docker Compose only
POSTGRES_PASSWORD=change-me
# Profiles "platform" and "monitoring" (local development defaults are used when unset)
# MINIO_ROOT_USER=inspect-rag
# MINIO_ROOT_PASSWORD=
# GRAFANA_ADMIN_PASSWORD=
